{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auto-Agent",
  "version": "2.0.0-beta.1",
  "identifier": "com.gamstek.autoagent",
  "build": {
    "beforeDevCommand": "pnpm run prepare:backend && pnpm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm run prepare:backend && pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "量仔 · AI 助理",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 640,
        "backgroundColor": "#edf4f5",
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; script-src 'self'; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "plugins": {
    "updater": { "pubkey": "" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/auto-agent-backend"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "languages": ["SimpChinese", "English"] }
    }
  }
}
