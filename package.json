{
  "name": "auto-agent",
  "version": "2.0.0-beta.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.15.1 <11",
    "bun": ">=1.4.2"
  },
  "scripts": {
    "preinstall": "node scripts/require-pnpm.cjs",
    "desktop:dev": "pnpm --filter auto-agent-desktop run desktop:dev",
    "desktop:build": "pnpm --filter auto-agent-desktop run desktop:build",
    "desktop:test": "pnpm --filter auto-agent-desktop run test:ui",
    "dev": "bun scripts/dev.ts",
    "start": "bun src/index.ts",
    "test": "bun test && pnpm -r --if-present run test",
    "test:agent": "bun test",
    "typecheck": "pnpm run typecheck:agent && pnpm -r --if-present run typecheck",
    "typecheck:agent": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:windows": "bun scripts/build.ts windows",
    "build:linux": "bun scripts/build.ts linux"
  },
  "dependencies": {
    "@auto-agent/climber-mcp": "workspace:*",
    "@auto-agent/wiki-core": "workspace:*",
    "@auto-agent/wiki-sam": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "ajv": "8.20.0",
    "@ai-sdk/openai-compatible": "3.0.67",
    "@langchain/langgraph": "1.4.21",
    "@langchain/langgraph-checkpoint": "1.1.6",
    "ai": "7.0.136",
    "marked": "17.0.1",
    "yaml": "2.9.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
