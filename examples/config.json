{
  "dataDir": "../.auto-agent",
  "wikiRoots": [],
  "wikiIndexRoots": [],
  "builtinWiki": true,
  "skillRoots": ["skills"],
  "builtinSkills": true,
  "host": "127.0.0.1",
  "port": 4096,
  "webAllowPrivateAddresses": true,
  "model": "deepseek-flash",
  "baseURL": "https://api.deepseek.com",
  "interpreters": {
    ".js": "node",
    ".ps1": "powershell.exe",
    ".sh": "bash"
  },
  "scriptTimeoutMs": 30000,
  "scriptEnv": {
    "CLIMBER_SERVICE_URL": "http://127.0.0.1:19181",
    "CLIMBER_TIMEOUT_MS": "5000"
  },
  "outputLimitBytes": 65536,
  "maxSteps": 12,
  "maxInputTokens": 1000000,
  "maxOutputTokens": 16000,
  "maxConcurrent": 4,
  "systemPrompt": ""
}
