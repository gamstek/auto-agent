{
  "name": "@auto-agent/climber-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "src",
    "dist"
  ],
  "exports": {
    ".": "./src/server.ts",
    "./server": "./src/server.ts",
    "./contracts": "./src/contracts.ts",
    "./controller": "./src/controller.ts",
    "./cli": "./src/cli.ts"
  },
  "scripts": {
    "start": "node --import tsx src/cli.ts",
