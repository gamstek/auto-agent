    "build": "node --import tsx scripts/build.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "tsx": "^4.23.15",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "catalog:"
  }
