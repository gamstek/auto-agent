+export * from "#corax-channel/index.js";
+import { coraxChannel as nativeCoraxChannel } from "#corax-channel/index.js";
+import { createSessionTitleRoute } from "#corax-channel/session-title.js";
+
+export function coraxChannel(input = {}) {
+  const channel = nativeCoraxChannel(input);
+  return { ...channel, routes: [...channel.routes, createSessionTitleRoute(input)] };
+}
