@@ -0,0 +1,12 @@
+import { posix, win32 } from 'node:path';
+
+// Paths belong to the provider, which may run on a different OS than Corax.
+export function isWindowsPath(path) {
+  return /^[a-z]:[\\/]/i.test(path) || /^(?:\\\\|\/\/)[^\\/]+[\\/][^\\/]+/.test(path);
+}
+export function isAbsolutePath(path) {
+  return !/[\0\r\n]/.test(path) && (path.startsWith('/') || isWindowsPath(path));
+}
+export function normalizePath(path) {
+  return isWindowsPath(path) ? win32.normalize(path).replaceAll('\\', '/') : posix.normalize(path);
+}
