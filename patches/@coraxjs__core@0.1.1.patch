index 0000000000000000000000000000000000000000..1a45a489e6be6e3d4db3b9c00134ff6153ab7eb0
--- /dev/null
+++ b/dist/src/corax-channel/session-title.js
@@ -0,0 +1,63 @@
+import { PATCH } from "#public/definitions/channel.js";
+import { routeAuth } from "#public/channels/auth.js";
+import { getWorld } from "#internal/workflow/runtime.js";
+import { isMissingWorkflowRunError } from "#internal/workflow/is-inactive-workflow-run-error.js";
+
+// Metadata only: no session dispatch, workflow replay or message-stream writes.
+export function createSessionTitleRoute(input, resolveWorld = getWorld) {
+  return PATCH("/corax/v1/session/:sessionId/title", async (request, context) => {
+    const auth = await routeAuth(request, input.auth);
+    if (auth instanceof Response) return auth;
+    const id = context.params.sessionId;
+    if (!/^wrun_[A-Za-z0-9]{26}$/.test(id ?? ""))
+      return Response.json({ ok: false, error: "Invalid session ID." }, { status: 400 });
+    let body;
+    try {
+      if (!request.body) throw new Error("Missing body");
+      const reader = request.body.getReader();
+      const chunks = [];
+      let size = 0;
+      try {
+        while (true) {
+          const next = await reader.read();
+          if (next.done) break;
+          size += next.value.byteLength;
+          if (size > 4096) {
+            await reader.cancel();
+            throw new Error("Body too large");
+          }
+          chunks.push(next.value);
+        }
+      } finally { reader.releaseLock(); }
+      body = JSON.parse(Buffer.concat(chunks).toString("utf8"));
+    } catch {
+      return Response.json({ ok: false, error: "Invalid title request." }, { status: 400 });
+    }
+    if (!body || typeof body !== "object" || Array.isArray(body) ||
+        Object.keys(body).length !== 1 || typeof body.title !== "string" ||
+        /[\x00-\x1f\x7f]/u.test(body.title))
+      return Response.json({ ok: false, error: "Invalid session title." }, { status: 400 });
+    const title = body.title.trim();
+    if (!title || Array.from(title).length > 100 || Buffer.byteLength(title, "utf8") > 1024)
+      return Response.json({ ok: false, error: "Title must contain 1 to 100 characters." }, { status: 400 });
+    try {
+      const world = await resolveWorld();
+      const run = await world.runs.get(id, { resolveData: "none" });
+      if (run.attributes?.["$corax.type"] !== "session" || run.attributes?.["$corax.parent"] ||
+          (run.attributes?.["$corax.session"] && run.attributes["$corax.session"] !== id))
+        return Response.json({ ok: false, error: "Session not found." }, { status: 404 });
+      if (!world.runs.experimentalSetAttributes)
+        return Response.json({ ok: false, error: "Session metadata updates are unavailable." }, { status: 501 });
+      // Store on the stable anchor. A handoff or derived title cannot override a user edit.
+      await world.runs.experimentalSetAttributes(id, [
+        { key: "$corax.title", value: title },
+        { key: "$corax.user_title", value: title },
+      ], { allowReservedAttributes: true });
+      return Response.json({ id, title }, { headers: { "cache-control": "no-store" } });
+    } catch (error) {
+      return Response.json({ ok: false, error: isMissingWorkflowRunError(error)
+        ? "Session not found." : "Unable to update session title." },
+        { status: isMissingWorkflowRunError(error) ? 404 : 503 });
+    }
+  });
+}
